# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Hanya variabel berawalan VITE_ yang masuk ke bundle browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase otomatis menyediakan SUPABASE_URL dan SUPABASE_SERVICE_ROLE_KEY
# untuk Edge Functions. Jangan menyalin service role key ke .env.local
# kecuali untuk script lokal yang tidak di-commit.

# ── Pembayaran ────────────────────────────────────────────────────────────────
# Tidak ada secret pembayaran. Rekening dan nomor WhatsApp admin diatur di
# database: tabel site_settings, key `bank_details` dan `official_contacts`
# (bisa diubah dari panel admin → Landing Page).
