# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Hanya variabel berawalan VITE_ yang masuk ke bundle browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase Edge Functions (server-side only) ───────────────────────────────
# Jangan pernah menaruh nilai ini di file yang di-commit.
# Set lewat: supabase secrets set KEY=value
PAKASIR_SLUG=your-project-slug
PAKASIR_API_KEY=your-api-key

# Supabase otomatis menyediakan SUPABASE_URL dan SUPABASE_SERVICE_ROLE_KEY
# untuk Edge Functions. Jangan menyalin service role key ke .env.local
# kecuali untuk script lokal yang tidak di-commit.
