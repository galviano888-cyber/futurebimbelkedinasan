{
  "name": "shadcn-ui-template",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:report": "playwright show-report",
    "db:push": "supabase db push --linked",
    "db:diff": "supabase db diff --linked",
    "db:reset": "supabase db reset",
    "check:flow": "node scripts/e2e-flow.mjs",
    "check:status-paket": "node scripts/e2e-status.mjs",
    "check:analytics": "node scripts/e2e-analytics.mjs",
    "check:security": "node scripts/probe-rls.mjs && node scripts/probe-student.mjs",
    "check:status": "node scripts/db-status.mjs",
    "check:encoding": "node scripts/fix-mojibake.mjs",
    "db:backup": "node scripts/backup-data.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.103.3",
    "@tailwindcss/vite": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.6.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.72.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-helmet-async": "^1.0.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1"
  }
}
